# ============================================================
# LedgerIQ — Agentic Financial Reconciliation
# Environment Variables Configuration Template
# ============================================================
# 1. Copy this file to '.env'
# 2. Replace placeholders with your credentials
# 3. Never commit the active '.env' file
# ============================================================

# --- Database (MongoDB) ---
# Default database name is lumina_db to preserve existing local data.
# Override with MONGODB_DB_NAME=ledgeriq_db only if you want a fresh database.
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB_NAME=lumina_db

# --- AI Engine (Google Cloud & Gemini) ---
GOOGLE_APPLICATION_CREDENTIALS=./gcp-credentials.json
GOOGLE_CLOUD_PROJECT=your_gcp_project_id
GOOGLE_CLOUD_LOCATION=us-central1
GEMINI_MODEL=gemini-3-flash-preview
GEMINI_API_KEY=your_gemini_api_key_here

# --- Mail (SMTP) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=noreply@ledgeriq.local

# --- Backend ---
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
SECRET_KEY=generate_a_secure_random_string_for_production
DEBUG=true
FRONTEND_BASE_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000

# JWT signing uses SECRET_KEY.

# --- Admin seed (first login) ---
# LUMINA_PASSWORD remains a supported alias.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
ADMIN_EMAIL=admin@ledgeriq.local

# --- MCP ---
MCP_SERVER_URL=http://localhost:8000/mcp/sse

# --- ERP Integration Agent (optional) ---
ERP_SYNC_API_URL=http://localhost:8000
ERP_SYNC_API_KEY=
ERP_POLL_INTERVAL_SECONDS=3600
ERP_SOURCE_TYPE=excel
ERP_DATA_PATH=./data/erp_export.xlsx
COMPANY_ID=
COUNTERPARTY_ID=
